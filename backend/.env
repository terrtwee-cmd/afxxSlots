# Copia este archivo a .env y ajusta los valores antes de correr el backend.

PORT=4000

# Cambia esto por una cadena larga y aleatoria antes de usarlo en producción.
JWT_SECRET=01

# Clave simple para entrar al panel de admin (no es un usuario real, es una
# llave compartida solo para ti). Cámbiala.
ADMIN_KEY=Elpincheanfibio747

# Configuración del bono de depósito y el rollover (multiplicador sobre el bono).
# Ejemplo actual: 100% de bono, 9x de rollover sobre el bono.
# Se aplican cuando el admin autoriza un depósito desde el panel — no antes.
BONUS_PERCENT=100
BONUS_MULTIPLIER=9

# Nota: la Clabe/banco/beneficiario de depósito YA NO se configuran aquí.
# Se configuran desde el panel de admin (http://localhost:4000/admin) una vez
# que el backend está corriendo, y quedan guardados en backend/data.json.
ADMIN_PATH=micunadachupadildo
