# Copia este archivo a .env y ajusta los valores antes de correr el backend.

PORT=4000

# Cambia esto por una cadena larga y aleatoria antes de usarlo en producción.
JWT_SECRET=cambia-esto-por-algo-largo-y-aleatorio

# Clave simple para entrar al panel de admin (no es un usuario real, es una
# llave compartida solo para ti). Cámbiala.
ADMIN_KEY=cambia-esta-clave-admin

# Ruta del panel de admin. Cámbiala por algo que nadie adivine con solo
# probar rutas comunes (evita "admin", "panel", "dashboard", etc).
# Ejemplo: si pones ADMIN_PATH=micunadachupadildo, el panel queda en
# http://localhost:4000/micunadachupadildo — no en /admin.
ADMIN_PATH=micunadachupadildo

# Configuración del bono de depósito y el rollover (multiplicador sobre el bono).
# Ejemplo actual: 100% de bono, 9x de rollover sobre el bono.
# Se aplican cuando el admin autoriza un depósito desde el panel — no antes.
BONUS_PERCENT=100
BONUS_MULTIPLIER=9

# Nota: la Clabe/banco/beneficiario de depósito YA NO se configuran aquí.
# Se configuran desde el panel de admin (usando la ruta de ADMIN_PATH de
# arriba) una vez que el backend está corriendo, y quedan guardados en
# backend/data.json.

# ------------------------------------------------------------------
# Telegram (el bot): avisa de cada registro nuevo y guarda la base de datos.
# ESTOS DOS VALORES SON SECRETOS: no los subas a GitHub ni los pegues en
# ningún chat. El token se consigue con @BotFather en Telegram.
#
# Con estos dos valores el servidor ya sobrevive a los reinicios de Render:
# la base de datos se guarda en el chat del bot y se restaura al arrancar.
# ------------------------------------------------------------------
# TELEGRAM_BOT_TOKEN=123456789:AAH...   <- secreto, no lo publiques
# TELEGRAM_CHAT_ID=123456789

# ------------------------------------------------------------------
# ALMACEN DE LA BASE DE DATOS (importante en Render)
# ------------------------------------------------------------------
# El disco de Render es efimero: en cada reinicio se borra. Para que los
# usuarios, sus contrasenas y la clabe sobrevivan, la base de datos se guarda
# en Telegram (el bot) y se restaura al arrancar.
#
# ESTAS DOS VARIABLES SON LAS IMPORTANTES (ya hacen falta para el backup):
# TELEGRAM_BOT_TOKEN=  <- el token del bot
# TELEGRAM_CHAT_ID=    <- tu chat (donde llega todo)
#
# Con solo estas dos la base de datos ya sobrevive a los reinicios. No hace
# falta ningun token de GitHub.
#
# OPCIONAL: una copia extra en la rama "data" del repo (si el repo es
# publico, se puede LEER sin token; para escribirlo si hace falta un PAT):
# GITHUB_TOKEN=ghp_xxx
# GITHUB_REPO=terrtwee-cmd/afxxSlots
# GITHUB_DATA_BRANCH=data
# ------------------------------------------------------------------

# AVISO IMPORTANTE
# Este archivo (.env) y backend/data.json NUNCA deben subirse al repositorio.
# Ya están en .gitignore. Si alguna vez se suben, quedan expuestos para
# cualquiera que pueda ver el repo: rota el token de Telegram, el ADMIN_KEY
# y el JWT_SECRET, y regenera la base de datos.
# Copia este archivo a .env y ajusta los valores en tu maquina.
