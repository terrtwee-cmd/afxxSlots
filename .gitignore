.env
node_modules/

# Secretos del servidor: NUNCA deben subirse al repo.
# (ADMIN_KEY / JWT_SECRET / TELEGRAM_BOT_TOKEN viven en backend/.env)
#
# La base de datos (usuarios, contrasenas en texto plano, clabe) NO se
# versiona en main: vive en la rama "data" del repo y se copia a Telegram.
# En main solo queda backend/data.base.json, que es una plantilla SIN
# usuarios ni contrasenas.
backend/data.json
backend/_backup/
*.log
